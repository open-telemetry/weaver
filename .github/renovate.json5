{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  packageRules: [
    {
      groupName: 'all digest versions',
      matchUpdateTypes: [
        'digest',
      ],
      schedule: [
        'before 8am every weekday',
      ],
    },
    {
      enabled: false,
      matchCategories: ['ci'],
      matchFileNames: [
        // this file needs to be synced with cargo dist-workspace hence using custom manager
        ".github/workflows/release.yml"
      ],
    },
    {
      groupName: 'Release workflow updates',
      matchDepTypes: ["action"],
      matchFileNames: [
        "dist-workspace.toml",
        ".github/workflows/release.yml"
      ],
      branchName: "{{branchPrefix}}cargo-dist-action-updates",
    },
    {
      groupName: 'all patch versions',
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'before 8am every weekday',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      groupName: 'rust',
      matchPackageNames: [
        '/^rust$/',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      groupName: 'docker',
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      matchManagers: [
        'cargo',
        'dockerfile',
        'npm',
      ],
      automerge: true,
    },
    {
      // Disable built-in github-actions rust-version bumps on the pinned nightly used by
      // cargo-check-external-types; it is tracked via customDatasources below so it stays
      // compatible with awslabs/cargo-check-external-types.
      matchManagers: [
        'github-actions',
      ],
      matchFileNames: [
        '.github/workflows/ci.yml',
      ],
      matchCurrentValue: '/^nightly-/',
      enabled: false,
    },
    {
      groupName: 'cargo-check-external-types',
      matchPackageNames: [
        'cargo-check-external-types',
        'cargo-check-external-types-nightly',
      ],
      schedule: [
        'before 8am on Monday',
      ],
    },
  ],
  customDatasources: {
    'cargo-check-external-types-nightly': {
      // Pinned to an immutable release commit SHA (updated by Renovate in its own PR before
      // the cargo-check-external-types + nightly PR picks up the new toolchain).
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/awslabs/cargo-check-external-types/61d284da26e8bbaca386a5b9f34bee30e82aaa0e/rust-toolchain.toml', // v0.5.0
      format: 'toml',
      transformTemplates: [
        '{"releases": [{"version": toolchain.channel}], "sourceUrl": "https://github.com/awslabs/cargo-check-external-types"}',
      ],
    },
  },
  customManagers: [
    {
      customType: "regex",
      description: "Update Cargo Dist workspace",
      managerFilePatterns: [
        "dist-workspace.toml",
        ".github/workflows/release.yml"
      ],
      matchStrings: [
        "(?<packageName>.+?)-version = \"(?<depVersion>[0-9.]+)\"",
        "https:\/\/github.com\/axodotdev\/(?<packageName>.+?)\/releases\/download\/v(?<depVersion>[0-9.]+)\/"
      ],
      datasourceTemplate: "crate",
      versioningTemplate: "semver",
      currentValueTemplate: "{{depVersion}}",
      depTypeTemplate: "workspace.dependencies",
    },
    {
      customType: "regex",
      description: "Update Cargo Dist Actions",
      managerFilePatterns: [
        "dist-workspace.toml",
      ],
      matchStrings: [
        "\"(?<packageName>.+\/?)\" = \"(?<currentDigest>[a-f0-9]{40})\" # v(?<depVersion>[0-9.]+)"
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      currentValueTemplate: "{{depVersion}}",
      extractVersionTemplate: "^v(?<version>.*)$",
      autoReplaceStringTemplate: "\"{{depName}}\" = \"{{newDigest}}\" # v{{newVersion}}",
      depTypeTemplate: "action",
    },
    {
      customType: "regex",
      description: "Update Cargo Dist YAML CI Actions Template",
      managerFilePatterns: [
        ".github/build-setup.yml",
      ],
      matchStrings: [
        "uses: (?<packageName>.+?)@(?<currentDigest>[a-f0-9]{40}) # v(?<depVersion>[0-9.]+)"
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      currentValueTemplate: "{{depVersion}}",
      extractVersionTemplate: "^v(?<version>.*)$",
      autoReplaceStringTemplate: "uses: {{depName}}@{{newDigest}} # v{{newVersion}}",
      depTypeTemplate: "action",
    },
    {
      customType: "regex",
      description: "Update Cargo Dist YAML CI Actions",
      managerFilePatterns: [
        ".github/workflows/release.yml",
      ],
      matchStrings: [
        "uses: \"?(?<packageName>.+?)@(?<currentDigest>[a-f0-9]{40})"
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      currentValueTemplate: "0.0.0",
      extractVersionTemplate: "^v(?<version>.*)$",
      depTypeTemplate: "action",
    },
    {
      customType: "regex",
      description: "Update pnpm version in Dockerfile",
      managerFilePatterns: [
        "Dockerfile",
      ],
      matchStrings: [
        "npm install -g pnpm@(?<currentValue>[0-9.]+)",
      ],
      depNameTemplate: "pnpm",
      datasourceTemplate: "npm",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Update pinned cargo install tools (justfile and CI)",
      managerFilePatterns: [
        "justfile",
        ".github/workflows/ci.yml",
      ],
      matchStrings: [
        "cargo install (?<packageName>[^@\\s]+)@(?<depVersion>[0-9.]+)",
      ],
      datasourceTemplate: "crate",
      versioningTemplate: "semver",
      currentValueTemplate: "{{depVersion}}",
      depTypeTemplate: "workspace.dependencies",
    },
    {
      customType: "regex",
      description: "Update pinned commit SHA for cargo-check-external-types upstream rust-toolchain.toml",
      managerFilePatterns: [
        ".github/renovate.json5",
      ],
      matchStrings: [
        "defaultRegistryUrlTemplate: 'https://raw\\.githubusercontent\\.com/(?<packageName>awslabs/cargo-check-external-types)/(?<currentDigest>[a-f0-9]{40})/rust-toolchain\\.toml', // v(?<depVersion>[0-9.]+)",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      currentValueTemplate: "{{depVersion}}",
      extractVersionTemplate: "^v(?<version>.*)$",
      autoReplaceStringTemplate: "defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/{{depName}}/{{newDigest}}/rust-toolchain.toml', // v{{newVersion}}",
    },
    {
      customType: "regex",
      description: "Update cargo-check-external-types nightly toolchain from upstream rust-toolchain.toml",
      managerFilePatterns: [
        ".github/workflows/ci.yml",
        "scripts/check_external_types.sh",
        "justfile",
      ],
      matchStrings: [
        "toolchain:\\s*\"?(?<currentValue>nightly-\\d{4}-\\d{2}-\\d{2})\"?",
        "cargo \\+(?<currentValue>nightly-\\d{4}-\\d{2}-\\d{2}) check-external-types",
        "rustup toolchain install (?<currentValue>nightly-\\d{4}-\\d{2}-\\d{2})",
      ],
      depNameTemplate: "cargo-check-external-types-nightly",
      datasourceTemplate: "custom.cargo-check-external-types-nightly",
      versioningTemplate: "regex:^nightly-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$",
    },
    {
      customType: "regex",
      description: "Update Rust toolchain version in justfile",
      managerFilePatterns: [
        "justfile",
      ],
      matchStrings: [
        "rustup (?:install|update) (?<currentValue>[0-9.]+)",
      ],
      datasourceTemplate: "rust-version",
      depNameTemplate: "rust",
      depTypeTemplate: "toolchain",
    },
    {
      customType: "regex",
      description: "Update otel/weaver Docker image references (justfile, CI, docs)",
      managerFilePatterns: [
        "justfile",
        ".github/workflows/ci.yml",
        "crates/weaver_live_check/docs/dog-fooding.md",
      ],
      matchStrings: [
        "otel\\/weaver:(?<currentValue>v[\\d.]+)",
      ],
      depNameTemplate: "otel/weaver",
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update downstream-check semantic-conventions version",
      managerFilePatterns: [
        "downstream-check.yaml",
      ],
      matchStrings: [
        "https:\/\/github\\.com\/(?<packageName>open-telemetry\/semantic-conventions)(?:\\.git)?@v(?<currentValue>[0-9.]+)",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>.*)$",
      autoReplaceStringTemplate: "https://github.com/open-telemetry/semantic-conventions.git@v{{newVersion}}",
    },
    {
      customType: "regex",
      description: "Update downstream-check opentelemetry-rust version",
      managerFilePatterns: [
        "downstream-check.yaml",
      ],
      matchStrings: [
        "https:\/\/github\\.com\/(?<packageName>open-telemetry\/opentelemetry-rust)(?:\\.git)?@opentelemetry-semantic-conventions-(?<currentValue>[0-9.]+)",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
      extractVersionTemplate: "^opentelemetry-semantic-conventions-(?<version>.*)$",
      autoReplaceStringTemplate: "https://github.com/open-telemetry/opentelemetry-rust.git@opentelemetry-semantic-conventions-{{newVersion}}",
    },
  ],
  labels: [
    'dependencies',
  ],
}
